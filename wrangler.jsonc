{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trek",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  // The deployed version's own id, which the Worker mixes into its cache key
  // so a deploy invalidates every stored page instead of serving yesterday's
  // HTML for the rest of the half hour.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Not a secret: it is the number we print on a support page and want a
  // guide to open. Here rather than a dashboard setting so it is in the repo
  // and cannot be lost with an account.
  "vars": {
    "SUPPORT_WHATSAPP": "9779861322075"
  },
  // Daily 02:00 UTC — scheduled() fans out to every /api/cron/:job sweep.
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}
