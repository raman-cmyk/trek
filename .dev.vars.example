# Copy to .dev.vars for local dev (gitignored). Founder sets the real values in
# the Cloudflare dashboard for production. See docs/CLAUDE.md §Environment.
#
# 🙋 Founder browser tasks to obtain these — not needed for M0/M1 (schema, seed,
# and primitives all run against local Supabase with no external services):

# Supabase — from the project's API settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server only, never exposed to the client

# Stripe — test mode until M6
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email / SMS / analytics — wired in M7-M9
RESEND_API_KEY=
SPARROW_SMS_TOKEN=
POSTHOG_KEY=

# Public site URL (used for canonical/OG tags)
SITE_URL=http://localhost:5173
